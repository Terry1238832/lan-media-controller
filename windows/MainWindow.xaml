<Window x:Class="LanMediaController.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="四端局域网媒体控制器"
        Width="560"
        Height="760"
        MinWidth="490"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="#0B1120"
        Foreground="#F8FAFC"
        FontFamily="Microsoft YaHei UI, Segoe UI">
    <Window.Resources>
        <Style x:Key="DarkButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.72"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#090E1A"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="CaretBrush" Value="#60A5FA"/>
            <Setter Property="BorderBrush" Value="#25344E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="2"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="18,16,18,22">
            <!-- Header Bar -->
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="38" Height="38" CornerRadius="11" Margin="0,0,12,0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#3B82F6" Offset="0"/>
                            <GradientStop Color="#8B5CF6" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <TextBlock Text="♫" FontSize="20" FontWeight="Bold" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="四端局域网媒体控制器" FontSize="16" FontWeight="Bold" Foreground="#F8FAFC"/>
                    <TextBlock Text="Native Windows · 启动自动开房" FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0"/>
                </StackPanel>

                <Border Grid.Column="2" Background="#162036" BorderBrush="#24334F" BorderThickness="1"
                        CornerRadius="16" Padding="12,6" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="7" Height="7" Fill="#10B981" Margin="0,0,7,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="LanNameText" Text="正在检测局域网..." FontSize="12"
                                   FontWeight="SemiBold" Foreground="#E2E8F0" MaxWidth="180" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Identity & Auto-Host Room Card -->
            <Border Background="#162036" BorderBrush="#24334F" BorderThickness="1" CornerRadius="16" Padding="16" Margin="0,0,0,14">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="本机设备名称" FontSize="12" FontWeight="SemiBold" Foreground="#94A3B8" VerticalAlignment="Center"/>
                        <Border Background="#1E3A5F" CornerRadius="7" Padding="9,3" HorizontalAlignment="Right">
                            <TextBlock Text="Windows" FontSize="11" FontWeight="Bold" Foreground="#60A5FA"/>
                        </Border>
                    </Grid>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="DeviceNameBox" Style="{StaticResource DarkTextBoxStyle}" MaxLength="24" Margin="0,0,8,0"/>
                        <Button Grid.Column="1" Content="保存名称" Style="{StaticResource DarkButtonStyle}"
                                Background="#26344E" Padding="14,9" Click="SaveNameBtn_Click"/>
                    </Grid>

                    <Border Height="1" Background="#24334F" Margin="0,0,0,14"/>

                    <!-- Current Room Bar -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="当前所在房间" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                <Border x:Name="RoomRoleBadge" Background="#143C33" CornerRadius="6" Padding="7,2" Margin="8,0,0,0">
                                    <TextBlock x:Name="RoomRoleText" Text="默认已开房" FontSize="10" FontWeight="Bold" Foreground="#34D399"/>
                                </Border>
                            </StackPanel>
                            <TextBlock x:Name="CurrentRoomNameText" Text="我的房间" FontSize="18" FontWeight="Bold"
                                       Foreground="#F8FAFC" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <Button x:Name="ReturnOwnRoomBtn" Grid.Column="1" Content="回到我的房间"
                                Style="{StaticResource DarkButtonStyle}" Background="#DC2626"
                                FontSize="12" Padding="12,8" VerticalAlignment="Center"
                                Visibility="Collapsed" Click="ReturnOwnRoomBtn_Click"/>
                    </Grid>

                    <!-- Discoverable Other Rooms (One-Click Join, No Code!) -->
                    <TextBlock Text="可加入的其他设备房间" FontSize="12" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,0,0,8"/>
                    <TextBlock x:Name="EmptyRoomsHint"
                               Text="正在自动发现其他设备房间，对方打开软件后可直接点击加入..."
                               FontSize="12" Foreground="#64748B" Margin="0,2,0,4" TextWrapping="Wrap"/>
                    <StackPanel x:Name="AvailableRoomsPanel"/>
                </StackPanel>
            </Border>

            <!-- Section Header -->
            <Grid Margin="4,0,4,10">
                <TextBlock Text="房间内设备播放器" FontSize="13" FontWeight="SemiBold" Foreground="#94A3B8"/>
                <TextBlock x:Name="DeviceCountText" Text="共 1 台设备在线" FontSize="12" Foreground="#64748B" HorizontalAlignment="Right"/>
            </Grid>

            <!-- Reusable Player Cards Container -->
            <StackPanel x:Name="PlayersContainer"/>
        </StackPanel>
    </ScrollViewer>
</Window>
